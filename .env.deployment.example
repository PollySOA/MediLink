# ============================================================================
# Azure Deployment Configuration
# ============================================================================
# Copy this file to .env.deployment and fill with your actual Azure values.
# Then run: source .env.deployment && bash scripts/deploy_backend_one_shot.sh
#
# IMPORTANT: Never commit .env.deployment to Git (it's in .gitignore)
# ============================================================================

# Azure Resource Group
# Where your Azure App Services are deployed
export RESOURCE_GROUP=rg-medilink-policy-frc

# Backend Web App Name
# Name of your backend Azure App Service
export WEBAPP_NAME=app-medilink-api-fr-06111153
export BACKEND_WEBAPP_NAME=app-medilink-api-fr-06111153

# Frontend Web App Name
# Uncomment and set when deploying frontend separately
# export WEBAPP_NAME=app-medilink-web-fr-06111223

# Backend API URL
# Full URL of your deployed backend (for frontend build)
export BACKEND_API_URL=https://app-medilink-api-fr-06111153.azurewebsites.net

# Smoke Test Credentials (optional)
# Override default demo credentials for deployment smoke tests
# export SMOKE_USER=dr.garcia
# export SMOKE_PASSWORD=demo1234

# ============================================================================
# Usage Instructions
# ============================================================================
# 
# 1. Copy this file:
#    cp .env.deployment.example .env.deployment
#
# 2. Edit .env.deployment with your actual Azure resource names
#
# 3. Load variables:
#    source .env.deployment
#
# 4. Deploy backend:
#    bash scripts/deploy_backend_one_shot.sh
#
# 5. Deploy frontend:
#    bash scripts/deploy_frontend_one_shot.sh
#
# 6. Deploy both (full-stack):
#    bash scripts/deploy_azure_one_shot.sh
#
# ============================================================================
